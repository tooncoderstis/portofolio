# Template environment produksi (EasyPanel). Isi di panel, JANGAN commit nilai asli.

# GitHub (PAT read-only)
GITHUB_TOKEN=
GITHUB_USERNAME=

# WakaTime
WAKATIME_API_KEY=

# Umami
UMAMI_API_URL=
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=

# MonkeyType
MONKEYTYPE_USERNAME=

# Infrastruktur (kredensial dari panel EasyPanel)
DATABASE_URL=postgres://user:password@host:5432/portofolio
REDIS_URL=redis://host:6379

# Situs
SITE_URL=https://<domain-anda>
NODE_ENV=production
