# Salin ke .env dan isi nilainya. JANGAN commit .env.

# GitHub (PAT classic, scope read:user; opsional public_repo)
GITHUB_TOKEN=
GITHUB_USERNAME=

# WakaTime
WAKATIME_API_KEY=

# Umami (self-host atau cloud)
UMAMI_API_URL=
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=

# MonkeyType (username cukup; API key opsional bila endpoint butuh ApeKey)
MONKEYTYPE_USERNAME=
MONKEYTYPE_API_KEY=

# Infrastruktur lokal (docker compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portofolio
REDIS_URL=redis://localhost:6379

# Situs
SITE_URL=http://localhost:3000
APP_VERSION=0.1.0

# Rahasia untuk memicu job snapshot (opsional di dev, wajib di produksi)
SNAPSHOT_SECRET=

# Hub proyek (owner-only). Buat hash & secret dengan: npm run hub:hash -- <password>
HUB_PASSWORD_HASH=
HUB_SESSION_SECRET=
# Rahasia untuk ingest laporan fase dari opencode (dipakai tiap proyek)
HUB_INGEST_SECRET=

# Web Push (VAPID). Buat dengan: npm run hub:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
